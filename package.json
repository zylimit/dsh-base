{
  "name": "deepseek-base",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness development scaffold: constitution, skill library, governance engine, gates.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "doctor": "node .dsh/base/dsb.mjs doctor",
    "selftest": "node .dsh/base/dsb.mjs selftest",
    "test": "node --test \"tests/*.test.mjs\"",
    "dod": "node .dsh/base/dsb.mjs dod",
    "gate": "node .dsh/base/dsb.mjs gate",
    "impact": "node .dsh/base/dsb.mjs impact",
    "arch:check": "node .dsh/base/dsb.mjs arch-check",
    "arch:record": "node .dsh/base/dsb.mjs arch-check --record",
    "arch:gate": "node .dsh/base/dsb.mjs arch-trend --gate",
    "fitness": "node .dsh/base/dsb.mjs fitness --all",
    "trace": "node .dsh/base/dsb.mjs trace",
    "risk": "node .dsh/base/dsb.mjs risk",
    "syntax": "node .dsh/base/audit/check-syntax.mjs",
    "secrets": "node .dsh/base/audit/scan-secrets.mjs",
    "manifest:write": "node .dsh/base/audit/manifest.mjs --write",
    "manifest:check": "node .dsh/base/audit/manifest.mjs --check",
    "hooks:install": "git config core.hooksPath .dsh/base/githooks"
  },
  "dependencies": {},
  "devDependencies": {}
}

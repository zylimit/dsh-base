      },
      "verification": [
        "syntax",
        "selftest"
      ]
    },
    {
      "id": "engine-cli",
      "paths": [
        ".dsh/base/dsb.mjs",
        ".dsh/base/AGENTS.md",
        ".dsh/base/install.mjs"
      ],
      "layer": "app",
      "owners": [
        "@maintainers"
      ],
      "riskTier": "high",
      "dependsOn": [
        "engine-core",
        "engine-graph",
        "engine-quality",
        "engine-scan",
        "engine-context",
        "engine-selftest",
        "engine-fleet"
      ],
      "attributes": {
        "security": "high",
        "reliability": "high"
      },
      "verification": [
        "syntax",
        "selftest",
        "unit",
        "fitness",

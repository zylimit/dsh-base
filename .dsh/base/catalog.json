{
  "version": 1,
  "project": {
    "name": "deepseek-base",
    "scaleTier": "M"
  },
  "maxTrackedPaths": 200000,
  "layers": [
    "doctrine",
    "tooling",
    "app",
    "capability",
    "platform"
  ],
  "global": [
    "package.json",
    ".gitignore",
    ".gitattributes",
    ".editorconfig",
    ".dsh/base/catalog.json",
    ".dsh/base/.gitignore",
    "FRAMEWORK-MANIFEST.json",
    ".dsh/base/cordis.patch.yml"
  ],
  "ignored": [
    {
      "path": "README.md",
      "reason": "human-facing entry point; changes no behaviour and is covered by manifest integrity"
    },
    {
      "path": "CHANGELOG.md",
      "reason": "release narrative; not an input to any check"
    },
    {
      "path": "LICENSE",
      "reason": "legal text; changing it is a HIGH-tier human decision, not a code path"
    },
    {
      "path": "progress.md",
      "reason": "project memory ledger; mutated by every session and would fan out every gate"
    },
    {
      "path": "progress.archive.md",
      "reason": "archived project memory"
    },
    {
      "path": ".dsh/base/catalog.example.json",
      "reason": "adoption template, never loaded by the engine"
    },
    {
      "path": ".dsh/base/adapters.json",
      "reason": "external-tool reference table, read by humans"
    },
    {
      "path": ".dsh/base/fitness-rules.json",
      "reason": "optional project rule extension; absent by default"
    },
    {
      "path": ".dsh/base/trend/**",
      "reason": "architecture-debt ledger; append-only measurement, not source"
    }
  ],
  "riskChecks": {
    "low": [
      "syntax"
    ],
    "medium": [
      "syntax",
      "selftest"
    ],
    "high": [
      "syntax",
      "selftest",
      "unit",
      "fitness",
      "instructions"
    ],
    "critical": [
      "syntax",
      "selftest",
      "unit",
      "fitness",
      "secrets",
      "instructions"
    ]
  },
  "checks": {
    "syntax": {
      "command": "node .dsh/base/audit/check-syntax.mjs",
      "class": "structure",
      "attributes": [
        "reliability"
      ],
      "allowFastSkip": false
    },
    "selftest": {
      "command": "node .dsh/base/dsb.mjs selftest",
      "class": "test",
      "attributes": [
        "reliability",
        "maintainability"
      ]
    },
    "unit": {
      "command": "node --test \"tests/*.test.mjs\"",
      "class": "test",
      "attributes": [
        "reliability"
      ],
      "allowFastSkip": true
    },
    "catalog": {
      "command": "node .dsh/base/dsb.mjs catalog-lint",
      "class": "structure",
      "attributes": [
        "maintainability"
      ]
    },
    "skills": {
      "command": "node .dsh/base/dsb.mjs skills-lint",
      "class": "structure",
      "attributes": [
        "maintainability"
      ]
    },
    "agents": {
      "command": "node .dsh/base/dsb.mjs agents-lint",
      "class": "structure",
      "attributes": [
        "maintainability"
      ]
    },
    "arch": {
      "command": "node .dsh/base/dsb.mjs arch-check",
      "class": "structure",
      "attributes": [
        "maintainability"
      ]
    },
    "adr": {
      "command": "node .dsh/base/dsb.mjs adr-check",
      "class": "review",
      "attributes": [
        "maintainability"
      ]
    },
    "spec": {
      "command": "node .dsh/base/dsb.mjs spec-lint",
      "class": "structure",
      "attributes": [
        "maintainability"
      ]
    },
    "trace": {
      "command": "node .dsh/base/dsb.mjs trace",
      "class": "test",
      "attributes": [
        "reliability"
      ],
      "allowFastSkip": true
    },
    "fitness": {
      "command": "node .dsh/base/dsb.mjs fitness --all",
      "class": "security",
      "attributes": [
        "security",
        "privacy",
        "safety",
        "resilience",
        "reliability"
      ]
    },
    "secrets": {
      "command": "node .dsh/base/audit/scan-secrets.mjs",
      "class": "security",
      "attributes": [
        "security",
        "privacy"
      ]
    },
    "manifest": {
      "command": "node .dsh/base/audit/manifest.mjs --check",
      "class": "security",
      "attributes": [
        "security",
        "maintainability"
      ]
    },
    "instructions": {
      "command": "node .dsh/base/audit/scan-instructions.mjs",
      "class": "security",
      "attributes": [
        "security",
        "privacy"
      ]
    }
  },
  "contextPack": {
    "maxTotalChars": 120000,
    "maxFiles": 40,
    "maxFileChars": 6000,
    "maxDiffChars": 40000
  },
  "budget": {
    "maxChangedFiles": 40,
    "maxChangedLines": 2000,
    "maxModulesTouched": 4,
    "maxNewFiles": 30
  },
  "trace": {
    "requirementDirs": [
      "docs/requirements",
      "docs/security",
      "docs/safety"
    ],
    "testGlobs": [
      "tests/**",
      "**/*.test.mjs",
      "**/*.test.js"
    ],
    "minCoverage": 1,
    "documentationGlobs": [
      "docs/**",
      ".dsh/docs/**",
      ".dsh/templates/**",
      ".dsh/skills/**",
      "*.md"
    ]
  },
  "adr": {
    "dir": "docs/adr"
  },
  "agentsMd": {
    "requireForRiskTiers": [
      "high",
      "critical"
    ],
    "maxBytes": 12000
  },
  "modules": [
    {
      "id": "engine-core",
      "paths": [
        ".dsh/base/lib/core.mjs",
        ".dsh/base/lib/AGENTS.md"
      ],
      "layer": "platform",
      "owners": [
        "@maintainers"
      ],
      "riskTier": "high",
      "dependsOn": [],
      "forbiddenDependencies": [
        "engine-graph",
        "engine-quality",
        "engine-scan",
        "engine-context",
        "engine-selftest",
        "engine-cli"
      ],
      "attributes": {
        "reliability": "high",
        "maintainability": "high"
      },
      "verification": [
        "syntax",
        "selftest",
        "unit",
        "arch"
      ]
    },
    {
      "id": "engine-graph",
      "paths": [
        ".dsh/base/lib/graph.mjs"
      ],
      "layer": "capability",
      "owners": [
        "@maintainers"
      ],
      "riskTier": "high",
      "dependsOn": [
        "engine-core"
      ],
      "forbiddenDependencies": [
        "engine-quality",
        "engine-scan",
        "engine-context",
        "engine-selftest",
        "engine-cli"
      ],
      "attributes": {
        "reliability": "high",
        "maintainability": "high"
      },
      "verification": [
        "syntax",
        "selftest",
        "unit",
        "arch"
      ]
    },
    {
      "id": "engine-quality",
      "paths": [
        ".dsh/base/lib/quality.mjs"
      ],
      "layer": "capability",
      "owners": [
        "@maintainers"
      ],
      "riskTier": "high",
      "dependsOn": [
        "engine-core",
        "engine-graph"
      ],
      "forbiddenDependencies": [
        "engine-scan",
        "engine-context",
        "engine-selftest",
        "engine-cli"
      ],
      "attributes": {
        "security": "high",
        "reliability": "high",
        "maintainability": "high"
      },
      "verification": [
        "syntax",
        "selftest",
        "unit",
        "fitness",
        "arch"
      ]
    },
    {
      "id": "engine-scan",
      "paths": [
        ".dsh/base/lib/scan.mjs"
      ],
      "layer": "capability",
      "owners": [
        "@maintainers"
      ],
      "riskTier": "high",
      "dependsOn": [
        "engine-core"
      ],
      "forbiddenDependencies": [
        "engine-quality",
        "engine-context",
        "engine-selftest",
        "engine-cli"
      ],
      "attributes": {
        "security": "high",
        "privacy": "high",
        "reliability": "high"
      },
      "verification": [
        "syntax",
        "selftest",
        "unit",
        "fitness",
        "secrets",
        "arch"
      ]
    },
    {
      "id": "engine-context",
      "paths": [
        ".dsh/base/lib/context.mjs"
      ],
      "layer": "capability",
      "owners": [
        "@maintainers"
      ],
      "riskTier": "critical",
      "dependsOn": [
        "engine-core",
        "engine-graph",
        "engine-quality",
        "engine-scan"
      ],
      "forbiddenDependencies": [
        "engine-selftest",
        "engine-cli"
      ],
      "attributes": {
        "security": "critical",
        "privacy": "high",
        "reliability": "high"
      },
      "attributeReasons": {},
      "verification": [
        "syntax",
        "selftest",
        "unit",
        "fitness",
        "secrets",
        "arch"
      ]
    },
    {
      "id": "engine-fleet",
      "paths": [
        ".dsh/base/lib/fleet.mjs"
      ],
      "layer": "capability",
      "owners": [
        "@maintainers"
      ],
      "riskTier": "high",
      "dependsOn": [
        "engine-core"
      ],
      "forbiddenDependencies": [
        "engine-quality",
        "engine-scan",
        "engine-context",
        "engine-selftest",
        "engine-cli"
      ],
      "attributes": {
        "reliability": "high",
        "maintainability": "high"
      },
      "verification": [

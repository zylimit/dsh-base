      ]
    },
    {
      "id": "engine-selftest",
      "paths": [
        ".dsh/base/lib/selftest.mjs"
      ],
      "layer": "app",
      "owners": [
        "@maintainers"
      ],
      "riskTier": "medium",
      "dependsOn": [
        "engine-core",
        "engine-graph",
        "engine-quality",
        "engine-scan",
        "engine-context",
        "engine-fleet"
      ],
      "forbiddenDependencies": [

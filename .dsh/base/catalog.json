        "fitness",
        "instructions"
      ]
    },
    {
      "id": "doctrine-workflows",
      "paths": [
        ".dsh/workflows/**"
      ],
      "layer": "doctrine",
      "owners": [
        "@maintainers"
      ],
      "riskTier": "low",
      "attributes": {
        "maintainability": "medium"
      },
      "verification": [
        "syntax",
        "fitness"
      ]
    },
    {
      "id": "doctrine-templates",
      "paths": [
        ".dsh/templates/**"
      ],
      "layer": "doctrine",
      "owners": [
        "@maintainers"
      ],
      "riskTier": "low",
      "attributes": {
        "maintainability": "medium"
      },
      "verification": [
        "fitness"
      ]
    },
    {
      "id": "doctrine-docs",
      "paths": [
        "docs/**",
        ".dsh/docs/**",
        "AGENTS.md"
      ],
      "layer": "doctrine",
      "owners": [
        "@maintainers"
      ],
      "riskTier": "medium",
      "attributes": {
        "maintainability": "high"
      },
      "verification": [
        "spec",
        "adr",
        "trace",
        "agents",
        "catalog",

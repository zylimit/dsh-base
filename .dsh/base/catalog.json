      ]
    },
    {
      "id": "tooling",
      "paths": [
        ".dsh/base/audit/**",
        "setup.ps1",
        "setup.sh",
        ".dsh/base/githooks/**",
        ".github/**"
      ],
      "layer": "tooling",
      "owners": [
        "@maintainers"
      ],
      "riskTier": "high",
      "attributes": {
        "security": "high",
        "maintainability": "medium"
      },
      "verification": [
        "syntax",
        "secrets",
        "fitness",
        "manifest",
        "instructions"
      ]
    },
    {
      "id": "tests",
      "paths": [
        "tests/**"
      ],
      "layer": "tooling",
      "owners": [
        "@maintainers"
      ],
      "riskTier": "medium",
      "dependsOn": [
        "engine-core",
        "engine-graph",
        "engine-quality",
        "engine-scan",
        "engine-context",
        "engine-cli",
        "tooling"
      ],
      "attributes": {
        "reliability": "high"
      },
      "verification": [
        "syntax",
        "unit",
        "selftest"
      ]
    }
  ],
  "memory": {
    "ledger": "progress.md",
    "archive": "progress.archive.md",
    "maxLedgerBytes": 24000,
    "keepDone": 40,
    "keepNotes": 30,
    "recapBudget": 6000
  },
  "cochange": {
    "minSample": 30,
    "accepted": [
      [
        "engine-selftest",
        "tests",
        "two halves of one concern: the engine's own verification. selftest covers pure functions, tests cover the process surface; a new capability necessarily touches both. Splitting them further would not reduce coupling, only hide it."
      ],
      [
        "doctrine-docs",
        "engine-graph",
        "the manual documents the engine, so a capability change moves both. Splitting them would leave the documentation describing an engine that no longer exists, which is the failure this coupling prevents."
      ],
      [
        "doctrine-docs",
        "tests",
        "a new capability arrives as engine + test + documentation in one change. The coupling is the delivery unit, not a boundary error."
      ],
      [
        "engine-cli",
        "tests",
        "the tests drive the CLI as a subprocess; the dependency is now declared, and the co-change is the normal shape of adding a subcommand with its behavioural test."
      ],
      [
        "engine-selftest",
        "tooling",
        "no code edge exists and none should: the audit scripts deliberately do not import the engine. They move together because a new capability arrives as engine assertion plus hook wiring in one change - a delivery unit, not a boundary."
      ],
      [
        "doctrine-docs",
        "engine-cli",
        "the command reference lives in the constitution and the manual, so adding a subcommand moves them with the CLI. There is no code edge and none should exist: the router must not import its own documentation."
      ],
      [
        "doctrine-docs",
        "engine-selftest",
        "the selftest count is cited in the manual, so a new assertion moves both. Delivery-unit coupling, not a boundary."
      ],
      [
        "doctrine-docs",
        "engine-scan",
        "the manual documents every command, and the capability registry these commands resolve through lives in scan.mjs. Delivery-unit coupling, not a boundary."
      ]
    ]
  },
  "rules": {
    "maxUnenforced": null,
    "note": "null means advisory. Set a number to make rules-audit a gate once the ratio is where you want it."
  },
  "review": {
    "profile": "production",
    "maxRounds": 3,
    "//": "this scaffold gates other people's code, so a defect here is a defect everywhere it is installed"
  }
}
